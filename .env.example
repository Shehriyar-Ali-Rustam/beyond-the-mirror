# ---------------------------------------------------------------------------
# Supabase — Project Settings → API (or `npx supabase status` locally)
# Both values are safe for the browser; access is enforced by Row Level Security.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.)

# Public URL of the deployed site, used for auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — shown in the safety banner. Set your local emergency number (e.g. 1122, 911, 999, 112).
NEXT_PUBLIC_CRISIS_LINE_NAME=Emergency services
NEXT_PUBLIC_CRISIS_LINE_NUMBER=

# ---------------------------------------------------------------------------
# SERVER/SCRIPT ONLY — never prefix with NEXT_PUBLIC_, never add to Vercel
# unless you know why. Used only by `npm run seed` to create demo accounts.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# Fallback timezone for rendering dates before the browser reports its own
# (e.g. Asia/Karachi, Europe/London, America/New_York).
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC
