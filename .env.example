# ---------------------------------------------------------------------------
# Supabase
# Easiest: Vercel → your project → Storage → Connect Supabase. That adds the
# variables below automatically (and the database tables are created on the
# next deploy). Otherwise copy them from Supabase → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (NEXT_PUBLIC_SUPABASE_ANON_KEY also works.)

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used to create username-based
# accounts and the admin login. (SUPABASE_SERVICE_ROLE_KEY also works.)
SUPABASE_SECRET_KEY=

# Optional: direct Postgres URL so `npm run build` applies supabase/migrations
# automatically. The Vercel integration provides POSTGRES_URL_NON_POOLING.
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Administrator login (no sign-up). A built-in admin login exists; set these
# only to override it.
# ---------------------------------------------------------------------------
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=School Administrator

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback timezone for rendering dates before the browser reports its own
# (e.g. Asia/Karachi, Europe/London, America/New_York).
NEXT_PUBLIC_DEFAULT_TIMEZONE=UTC

# Optional — shown in the safety banner. Set your local emergency number (e.g. 1122, 911, 999, 112).
NEXT_PUBLIC_CRISIS_LINE_NAME=Emergency services
NEXT_PUBLIC_CRISIS_LINE_NUMBER=
